# 本地 S1 开发库；请使用独立的 xingzhi_dev 数据库，不要连接其他项目的库。
DATABASE_URL=postgresql://localhost:5432/xingzhi_dev
PORT=8787
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# 仅用于本地演示种子账号；复制为 .env 后请自行替换。
SEED_DEMO_PASSWORD=change-this-local-demo-password

# S2 默认保持本地模拟，未完整配置时不会向支付宝发送请求。
PAYMENT_MODE=simulation
# 沙箱应用、买卖家和测试授权确认后填写；不得提交真实值。notify_url 仅在需要异步通知时填写，本机可留空。
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_SANDBOX_SELLER_ID=
ALIPAY_SANDBOX_GATEWAY=
# 可选；留空时支付完成后由服务端主动查单，不需要公网 HTTPS 地址。
ALIPAY_SANDBOX_NOTIFY_URL=
# 本机付款结束后返回的网页地址可为 http://localhost:5173。
ALIPAY_SANDBOX_RETURN_URL=http://localhost:5173

# S4 Pi + DeepSeek（当前仅登记选型，未配置密钥时不会发起外部模型调用）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 本地开发／验收环境累计模型费用上限（人民币）。
AGENT_COST_BUDGET_CNY=100
# 模型预算直接按 DeepSeek 官方人民币费率计入，无需汇率配置。
# 常规服务端令牌桶：每个已认证消费者每分钟请求数及突发容量。
AGENT_RATE_LIMIT_PER_MINUTE=10
AGENT_RATE_LIMIT_BURST=2
AGENT_MAX_ACTIVE_RUNS_PER_PLAN=1
