{
  "name": "@xingzhi/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:consumer-catalog": "tsx src/db/seed-consumer-catalog.ts",
    "db:seed:consumer-finance": "tsx src/db/seed-consumer-finance.ts",
    "typecheck": "tsc --noEmit",
    "test:targeted": "node --test --import tsx src/domain/*.test.ts src/payment/*.test.ts",
    "build": "tsc",
    "agent:smoke": "tsx src/agent-smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@xingzhi/contracts": "workspace:*",
    "alipay-sdk": "^4.14.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "pg": "^8.16.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
